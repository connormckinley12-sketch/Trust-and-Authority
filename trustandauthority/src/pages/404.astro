---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found | Trust & Authority" description="This page doesn't exist." path="/404/" noindex>
  <section aria-labelledby="nf-title">
    <div class="wrap prose">
      <hr class="rule" />
      <h1 id="nf-title">This page isn't here.</h1>
      <p>It may have moved, or it may not exist yet. <a href="/">Go to the home page</a>.</p>
    </div>
  </section>
</Base>
