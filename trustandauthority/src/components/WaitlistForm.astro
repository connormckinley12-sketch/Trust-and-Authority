---
// Waitlist form. Netlify Forms receives every submission under the name
// "waitlist" (registered by the hidden form in pages/index.astro), with
// `source` = hero | closing and `course` = the optional answer.
//
// • With JavaScript: validates inline, posts in the background, then goes to /thanks/.
// • Without JavaScript: native validation, plain POST, Netlify redirects to /thanks/.
import { courses } from '../data/site.js';

interface Props {
  id: string;                // unique prefix for field ids
  source: 'hero' | 'closing';
  withCourse?: boolean;
  note?: string;
}
const { id, source, withCourse = false, note } = Astro.props;
---
<form
  class="waitlist"
  name="waitlist"
  method="POST"
  action="/thanks/"
  data-waitlist
  data-source={source}
  aria-label={source === 'hero' ? 'Join the waitlist' : 'Join the waitlist and pick a course'}
>
  <input type="hidden" name="form-name" value="waitlist" />
  <input type="hidden" name="source" value={source} />
  <p hidden>
    <label>Leave this empty <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
  </p>

  <div class="row">
    <div class="field">
      <label for={`${id}-name`}>First name</label>
      <input
        id={`${id}-name`}
        name="first_name"
        type="text"
        autocomplete="given-name"
        required
        maxlength="80"
        data-error="Enter your first name."
      />
      <p class="field-error" id={`${id}-name-error`} hidden></p>
    </div>
    <div class="field">
      <label for={`${id}-email`}>Email</label>
      <input
        id={`${id}-email`}
        name="email"
        type="email"
        autocomplete="email"
        inputmode="email"
        spellcheck="false"
        required
        maxlength="254"
        data-error="Enter an email address, like name@example.com."
      />
      <p class="field-error" id={`${id}-email-error`} hidden></p>
    </div>
  </div>

  {withCourse && (
    <fieldset class="course">
      <legend>Which course would you take first? <span class="optional">(optional)</span></legend>
      <ul role="list">
        {courses.map((c) => (
          <li>
            <input type="radio" id={`${id}-course-${c.value}`} name="course" value={c.value} />
            <label for={`${id}-course-${c.value}`}>{c.title}</label>
          </li>
        ))}
        <li>
          <input type="radio" id={`${id}-course-not-sure`} name="course" value="not-sure" />
          <label for={`${id}-course-not-sure`}>Not sure yet</label>
        </li>
      </ul>
    </fieldset>
  )}

  <div class="field check">
    <input
      id={`${id}-consent`}
      name="consent"
      type="checkbox"
      value="yes"
      required
      data-error="Check this box so we can send you course updates."
    />
    <label for={`${id}-consent`}>Send me course updates and occasional notes from Molly.</label>
    <p class="field-error" id={`${id}-consent-error`} hidden></p>
  </div>

  <div class="actions">
    <button class="btn" type="submit">Join the waitlist</button>
    {note && <p class="small note">{note}</p>}
  </div>
  <p class="form-status" role="status" aria-live="polite"></p>
</form>

<style>
  .waitlist { display: grid; gap: 1.25rem; max-width: 36rem; text-align: left; }
  .row { display: grid; gap: 1.25rem; }
  @media (min-width: 40rem) {
    .row { grid-template-columns: 1fr 1.4fr; }
  }
  .field { display: grid; gap: .375rem; align-content: start; }
  label, legend {
    font-size: 1rem;
    font-weight: 500;
    color: var(--ink);
  }
  input[type='text'], input[type='email'] {
    width: 100%;
    min-height: 3.25rem;
    padding: .75rem .875rem;
    font: inherit;
    color: var(--ink);
    background: var(--parchment);
    border: 1px solid var(--warm-umber);   /* 4.41:1 on Parchment; ≥3:1 needed */
    border-radius: 3px;
  }
  input[aria-invalid='true'] { border-color: var(--error); border-width: 2px; }

  .course { border: 0; padding: 0; margin: 0; }
  .course legend { padding: 0; margin-bottom: .5rem; }
  .optional { font-weight: 400; color: var(--umber-deep); }
  .course ul { list-style: none; margin: 0; padding: 0; display: grid; gap: .25rem; }
  .course li, .check { display: flex; align-items: flex-start; gap: .625rem; }
  .check { flex-wrap: wrap; }
  .check label { flex: 1 1 0; min-width: 0; }
  .check .field-error { flex-basis: 100%; }
  .course label, .check label { font-weight: 400; padding-block: .3rem; cursor: pointer; }
  input[type='radio'], input[type='checkbox'] {
    flex: none;
    width: 1.125rem;
    height: 1.125rem;
    margin: .55rem 0 0;
    accent-color: var(--peacock);
    cursor: pointer;
  }

  .field-error {
    margin: 0;
    font-size: .875rem;
    font-weight: 500;
    color: var(--error);
  }
  .field-error::before { content: 'Error: '; }

  .actions { display: grid; gap: .875rem; justify-items: start; }
  .actions .btn { width: 100%; }
  @media (min-width: 40rem) { .actions .btn { width: auto; } }
  .note { max-width: 28rem; }
  .form-status:empty { display: none; }
  .form-status { margin: 0; font-weight: 500; color: var(--error); }
</style>

<script>
  type Field = HTMLInputElement;

  function showError(input: Field, form: HTMLFormElement): boolean {
    const err = form.querySelector<HTMLElement>(`#${input.id}-error`);
    const invalid = !input.checkValidity();
    input.setAttribute('aria-invalid', String(invalid));
    if (err) {
      err.hidden = !invalid;
      err.textContent = invalid ? input.dataset.error || input.validationMessage : '';
      const ids = new Set((input.getAttribute('aria-describedby') || '').split(' ').filter(Boolean));
      invalid ? ids.add(err.id) : ids.delete(err.id);
      ids.size ? input.setAttribute('aria-describedby', [...ids].join(' ')) : input.removeAttribute('aria-describedby');
    }
    return !invalid;
  }

  function remember(name: string) {
    try { sessionStorage.setItem('ta-first-name', name); } catch { /* storage blocked: thanks page falls back */ }
  }

  document.querySelectorAll<HTMLFormElement>('form[data-waitlist]').forEach((form) => {
    form.noValidate = true; // we show our own text errors instead of browser bubbles
    const fields = [...form.querySelectorAll<Field>('[data-error]')];
    const status = form.querySelector<HTMLElement>('.form-status')!;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;

    fields.forEach((f) =>
      f.addEventListener(f.type === 'checkbox' ? 'change' : 'blur', () => {
        if (f.hasAttribute('aria-invalid')) showError(f, form);
      })
    );

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      status.textContent = '';
      const firstName = form.querySelector<Field>('[name="first_name"]')!;
      firstName.value = firstName.value.trim();

      const bad = fields.filter((f) => !showError(f, form));
      if (bad.length) { bad[0].focus(); return; }

      const data = new FormData(form);
      button.disabled = true;
      button.textContent = 'Joining…';
      try {
        const res = await fetch('/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams(data as unknown as Record<string, string>).toString(),
        });
        if (!res.ok) throw new Error(String(res.status));

        // Analytics: counts signups and course answers. No personal data sent.
        const course = (data.get('course') as string) || (form.dataset.source === 'hero' ? 'not-asked' : 'no-answer');
        (window as any).plausible?.('Waitlist signup', { props: { course, source: form.dataset.source } });

        remember(firstName.value);
        window.location.assign('/thanks/');
      } catch {
        button.disabled = false;
        button.textContent = 'Join the waitlist';
        status.textContent = "Something went wrong and you're not on the list yet. Please try again in a moment.";
      }
    });
  });
</script>
